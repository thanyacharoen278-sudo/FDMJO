local function TweenTo(cf)
    local h = HRP()
    if not h or not cf then
        return
    end
    CancelTween(moveTween)
    CancelTween(floatTween)
    pcall(function()
        local dist = (h.Position - cf.Position).Magnitude
        if dist < 5 then
            h.CFrame = cf
            ZeroVel()
            return
        end
        local t = math.clamp(dist / TWEEN_SPEED, 0.12, 5)
        moveTween = TweenService:Create(
            h,
            TweenInfo.new(t, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            { CFrame = cf }
        )
        moveTween:Play()
        moveTween.Completed:Wait()
    end)
    ZeroVel()
end

local function FloatOn(mob)
    local h = HRP()
    local eh = mob and mob:FindFirstChild("HumanoidRootPart")
    if not h or not eh then
        return
    end
    local goalPos = eh.Position + Vector3.new(0, FLOAT_HEIGHT, 0)
    local goalCF = CFrame.lookAt(goalPos, eh.Position + Vector3.new(0, 0.35, 0))
    local dist = (h.Position - goalPos).Magnitude
    local hu = Hum()
    if hu then
        hu.WalkSpeed = 0
        hu.JumpPower = 0
        hu.AutoRotate = false
    end
    if dist > 80 then
        CancelTween(floatTween)
        TweenTo(goalCF)
        return
    end
    if dist <= 2.5 then
        CancelTween(floatTween)
        h.CFrame = goalCF
        ZeroVel()
        return
    end
    CancelTween(floatTween)
    local t = math.clamp(dist / 100, 0.06, FLOAT_TWEEN_TIME)
    floatTween = TweenService:Create(
        h,
        TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = goalCF }
    )
    floatTween:Play()
    ZeroVel()
end

local function ExpandHitbox(mob)
    pcall(function()
        local r = mob:FindFirstChild("HumanoidRootPart")
        if r then
            r.Size = Vector3.new(120, 120, 120)
            r.Transparency = 1
            r.CanCollide = false
        end
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.JumpPower = 0
            hum.WalkSpeed = 0
        end
    end)
end

local function IsAliveEnemy(e)
    return e
        and e:FindFirstChild("Humanoid")
        and e:FindFirstChild("HumanoidRootPart")
        and e.Humanoid.Health > 0
end

local function FindRaidMobNear(islandCF)
    local best, bestD = nil, RAID_ISLAND_RANGE
    local origin = islandCF.Position
    pcall(function()
        for _, e in ipairs(workspace.Enemies:GetChildren()) do
            if IsAliveEnemy(e) then
                local d = (e.HumanoidRootPart.Position - origin).Magnitude
                if d < bestD then
                    bestD = d
                    best = e
                end
            end
        end
    end)
    return best
end

local function CountRaidMobsNear(islandCF)
    local n = 0
    local origin = islandCF.Position
    pcall(function()
        for _, e in ipairs(workspace.Enemies:GetChildren()) do
            if IsAliveEnemy(e) then
                if (e.HumanoidRootPart.Position - origin).Magnitude <= RAID_ISLAND_RANGE then
                    n = n + 1
                end
            end
        end
    end)
    return n
end

local function GoNextRaidIsland()
    if raidIslandIndex < #RaidIslands then
        raidIslandIndex = raidIslandIndex + 1
        raidArrived = false
        raidNoMobTimer = 0
    else
        raidNoMobTimer = 0
        for i = 1, #RaidIslands do
            if CountRaidMobsNear(RaidIslands[i]) > 0 then
                raidIslandIndex = i
                raidArrived = false
                break
            end
        end
    end
end

