                if not QuestReady() then
                    AbandonQuest()
                    task.wait(0.15)
                    local h = HRP()
                    if h and CFrameQ then
                        if (h.Position - CFrameQ.Position).Magnitude > 10 then
                            TweenTo(CFrameQ * CFrame.new(0, 4, 0))
                        end
                        local h2 = HRP()
                        if h2 and (h2.Position - CFrameQ.Position).Magnitude <= 14 then
                            TakeQuest()
                            task.wait(0.4)
                        end
                    end
                else
                    local target, bestD = nil, DETECT_RANGE
                    local hrp = HRP()
                    for _, e in ipairs(workspace.Enemies:GetChildren()) do
                        if e.Name == Ms and IsAliveEnemy(e) then
                            if hrp then
                                local d = (e.HumanoidRootPart.Position - hrp.Position).Magnitude
                                if d < bestD then
                                    bestD = d
                                    target = e
                                end
                            else
                                target = e
                                break
                            end
                        end
                    end
                    if target then
                        ExpandHitbox(target)
                        FloatOn(target)
                        AttackNoCoolDown()
                    else
                        pcall(function()
                            local spawns = workspace:FindFirstChild("_WorldOrigin")
                            spawns = spawns and spawns:FindFirstChild("EnemySpawns")
                            if not spawns or not NameMon or NameMon == "" then
                                return
                            end
                            for _, s in ipairs(spawns:GetChildren()) do
                                if string.find(s.Name, NameMon) then
                                    local p = s:FindFirstChild("HumanoidRootPart") or s.PrimaryPart
                                    if p then
                                        TweenTo(p.CFrame * Pos)
                                    elseif s:IsA("BasePart") then
                                        TweenTo(s.CFrame * Pos)
                                    end
                                    break
                                end
                            end
                        end)
                    end
                end
            end)
            task.wait(FAST_DELAY)
        end
    end
end)

