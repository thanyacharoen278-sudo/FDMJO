local function InitFastAttack()
    if FastAttackModule then
        return FastAttackModule
    end
    local ok, mod = pcall(function()
        local Modules = RS:FindFirstChild("Modules")
        local Net = Modules and Modules:FindFirstChild("Net")
        if not Net then
            return nil
        end
        local RegisterAttack = Net:FindFirstChild("RE/RegisterAttack")
        local RegisterHit = Net:FindFirstChild("RE/RegisterHit")
        if not RegisterAttack or not RegisterHit then
            return nil
        end

        local FA = {
            Distance = FA_DISTANCE,
            attackMobs = true,
            attackPlayers = false,
        }

        local function IsAlive(ch)
            return ch and ch:FindFirstChild("Humanoid") and ch.Humanoid.Health > 0
        end

        local function Collect(list, folder, maxDist)
            local base = nil
            if not folder then
                return base
            end
            for _, enemy in ipairs(folder:GetChildren()) do
                local head = enemy:FindFirstChild("Head")
                if head and IsAlive(enemy) and enemy \~= LP.Character then
                    local d = 0
                    pcall(function()
                        d = LP:DistanceFromCharacter(head.Position)
                    end)
                    if d > 0 and d < maxDist then
                        table.insert(list, { enemy, head })
                        base = head
                    end
                end
            end
            return base
        end

        function FA:Attack(basePart, others)
            if not basePart or not others or #others == 0 then
                return
            end
            pcall(function()
                RegisterAttack:FireServer(0)
                RegisterHit:FireServer(basePart, others)
            end)
        end

        function FA:AttackNearest()
            local others = {}
            local p1, p2 = nil, nil
            if self.attackMobs then
                p1 = Collect(others, workspace:FindFirstChild("Enemies"), self.Distance)
            end
            if self.attackPlayers then
                p2 = Collect(others, workspace:FindFirstChild("Characters"), self.Distance)
            end
            if #others > 0 then
                self:Attack(p1 or p2, others)
            end
        end

        function FA:BladeHits()
            local c = LP.Character
            if not IsAlive(c) then
                return
            end
            local tool = c:FindFirstChildOfClass("Tool")
            if tool then
                local tip = tostring(tool.ToolTip or "")
                if tip \~= "Gun" then
                    self:AttackNearest()
                end
            end
        end

        return FA
    end)
    if ok and mod then
        FastAttackModule = mod
    end
    return FastAttackModule
end

local function AttackNoCoolDown()
    if _G.FastAttack then
        pcall(function()
            local fa = InitFastAttack()
            if fa then
