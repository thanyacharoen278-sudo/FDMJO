local function TakeQuest()
    pcall(function()
        RS.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, QuestLv)
    end)
end

local function AbandonQuest()
    pcall(function()
        RS.Remotes.CommF_:InvokeServer("AbandonQuest")
    end)
end

local function QuestReady()
    local ready = false
    pcall(function()
        local q = LP.PlayerGui.Main.Quest
        if q.Visible and NameMon and string.len(NameMon) > 0 then
            local t = q.Container.QuestTitle.Title.Text
            if string.find(t, NameMon) then
                ready = true
            end
        end
    end)
    return ready
end

